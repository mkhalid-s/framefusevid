{
  "name": "framefusevid",
  "version": "0.1.0",
  "description": "Combine Zoom cloud recording files into a single video with customizable layouts",
  "author": "FrameFuseVid Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkhalid-s/framefusevid.git"
  },
  "bugs": {
    "url": "https://github.com/mkhalid-s/framefusevid/issues"
  },
  "homepage": "https://github.com/mkhalid-s/framefusevid#readme",
  "keywords": [
    "zoom",
    "video",
    "recording",
    "merge",
    "ffmpeg",
    "electron",
    "desktop",
    "privacy",
    "local-processing",
    "picture-in-picture",
    "video-editing",
    "zoom-recording",
    "cross-platform"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:vite": "vite",
    "build": "vite build && electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.263.1",
    "postcss": "^8.5.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "vite": "^7.3.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.framefusevid.app",
    "productName": "FrameFuseVid",
    "extends": null,
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    }
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
