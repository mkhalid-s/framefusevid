{
  "name": "framefusevid",
  "version": "0.1.0",
  "description": "Combine Zoom cloud recording files into a single video with customizable layouts",
  "author": "FrameFuseVid",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "react-scripts start",
    "build": "react-scripts build && electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "lucide-react": "^0.263.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.framefusevid.app",
    "productName": "FrameFuseVid",
    "extends": null,
    "directories": { "output": "dist" },
    "files": ["build/**/*", "src/main/**/*", "node_modules/**/*"],
    "mac": { "category": "public.app-category.video", "target": ["dmg"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Video" }
  },
  "homepage": "./",
  "browserslist": { "production": ["last 1 electron version"], "development": ["last 1 electron version"] }
}
